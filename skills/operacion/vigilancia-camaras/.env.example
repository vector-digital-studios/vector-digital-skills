# .env.example — copia a <carpeta de datos>/.env (por defecto %LOCALAPPDATA%\vigilancia-camaras\.env)
# Las variables de entorno del sistema tienen prioridad sobre este archivo. Nunca lo subas a Git.

# Bot de Telegram propio (créalo con @BotFather) y el chat donde llegan las alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MAC de HARDWARE del celular del dueño (una o varias separadas por espacio), formato xx-xx-xx-xx-xx-xx
# (también se aceptan ":" o los 12 dígitos hexadecimales seguidos)
VIGILANCIA_MAC=

# Opcionales
# VIGILANCIA_DATOS=      carpeta de datos alternativa
# VIGILANCIA_CONFIG=     ruta a config.toml
# VIGILANCIA_PYTHON=     intérprete con opencv-python y numpy
