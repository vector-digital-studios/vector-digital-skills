# Variables de entorno del sitio. Este archivo es un EJEMPLO: no pongas valores reales aquí ni lo subas.
# Genera los valores con:  node scripts/generar_claves.cjs   (pide la contraseña sin mostrarla)
# y cárgalos en Vercel con: vercel env add <NOMBRE> production   (ver references/despliegue.md)

# Hash de la contraseña de acceso. Formato recomendado: scrypt$<sal>$<hash> (base64url).
# También acepta 64 caracteres hex (SHA-256 sin sal) solo para contraseñas aleatorias largas.
SITE_PASSWORD_HASH=scrypt$REEMPLAZAR_SAL$REEMPLAZAR_HASH

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres aleatorios).
SESSION_SECRET=REEMPLAZAR_CON_32_O_MAS_CARACTERES_ALEATORIOS

# Opcional: secreto anterior, solo para verificar sesiones durante una rotación.
SESSION_SECRET_PREVIOUS=

# Opcionales (valores por defecto entre paréntesis)
# SESSION_COOKIE_NAME=sp_session
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15
# LOGIN_FAIL_DELAY_MS=400
